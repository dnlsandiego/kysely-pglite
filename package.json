{
  "name": "kysely-pglite",
  "version": "0.6.1",
  "description": "Kysely dialect for @electric-sql/pglite",
  "repository": "https://github.com/dnlsandiego/kysely-pglite",
  "keywords": [
    "@electric-sql/pglite",
    "kysely",
    "postgresql",
    "wasm",
    "database",
    "sql"
  ],
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@8.14.2",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "format": "prettier ./src --write",
    "test": "vitest"
  },
  "files": [
    "dist",
    "bin/run.js",
    "bin/run.cmd"
  ],
  "imports": {
    "#*": {
      "default": "./dist/*"
    }
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "kysely": "*"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@oclif/core": "^4.8.0",
    "@repeaterjs/repeater": "^3.0.6",
    "@sindresorhus/is": "^7.2.0",
    "chokidar": "^3.6.0",
    "consola": "^3.4.2",
    "fs-extra": "^11.3.3",
    "globby": "^14.1.0",
    "jiti": "2.0.0-beta.3",
    "kysely-codegen": "^0.19.0",
    "radash": "^12.1.1"
  },
  "bin": {
    "kysely-pglite": "./bin/run.js",
    "kpg": "./bin/run.js"
  },
  "oclif": {
    "binAliases": [
      "kysely-pglite",
      "kpg"
    ],
    "commands": {
      "strategy": "single",
      "target": "./dist/cli.js"
    },
    "dirname": "kysely-pglite",
    "topicSeparator": " "
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "glob": "*",
      "inflight": "*"
    }
  },
  "author": "Daniel Sandiego"
}
